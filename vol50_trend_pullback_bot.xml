<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">

  <block type="trade" x="20" y="20">
    <field name="SYMBOL">R_50</field>
    <field name="TRADETYPECAT">updown</field>
    <field name="TRADETYPE">rise_fall</field>
    <field name="DURATIONTYPE">m</field>
    <field name="DURATION">5</field>

    <statement name="STRATEGY">
      <block type="controls_if">

        <!-- BUY CONDITION -->
        <value name="IF0">
          <block type="logic_operation">
            <field name="OP">AND</field>

            <!-- EMA20 > EMA50 -->
            <value name="A">
              <block type="logic_compare">
                <field name="OP">GT</field>
                <value name="A">
                  <block type="indicator_moving_average">
                    <field name="PERIOD">20</field>
                    <field name="TYPE">ema</field>
                  </block>
                </value>
                <value name="B">
                  <block type="indicator_moving_average">
                    <field name="PERIOD">50</field>
                    <field name="TYPE">ema</field>
                  </block>
                </value>
              </block>
            </value>

            <!-- RSI < 40 -->
            <value name="B">
              <block type="logic_compare">
                <field name="OP">LT</field>
                <value name="A">
                  <block type="indicator_rsi">
                    <field name="PERIOD">14</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number">
                    <field name="NUM">40</field>
                  </block>
                </value>
              </block>
            </value>

          </block>
        </value>

        <!-- BUY ACTION -->
        <statement name="DO0">
          <block type="purchase">
            <field name="CONTRACT_TYPE">CALL</field>
            <value name="AMOUNT">
              <block type="math_number">
                <field name="NUM">1</field>
              </block>
            </value>
          </block>
        </statement>

        <!-- SELL CONDITION -->
        <statement name="ELSE">
          <block type="controls_if">
            <value name="IF0">
              <block type="logic_operation">
                <field name="OP">AND</field>

                <!-- EMA20 < EMA50 -->
                <value name="A">
                  <block type="logic_compare">
                    <field name="OP">LT</field>
                    <value name="A">
                      <block type="indicator_moving_average">
                        <field name="PERIOD">20</field>
                        <field name="TYPE">ema</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="indicator_moving_average">
                        <field name="PERIOD">50</field>
                        <field name="TYPE">ema</field>
                      </block>
                    </value>
                  </block>
                </value>

                <!-- RSI > 60 -->
                <value name="B">
                  <block type="logic_compare">
                    <field name="OP">GT</field>
                    <value name="A">
                      <block type="indicator_rsi">
                        <field name="PERIOD">14</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number">
                        <field name="NUM">60</field>
                      </block>
                    </value>
                  </block>
                </value>

              </block>
            </value>

            <statement name="DO0">
              <block type="purchase">
                <field name="CONTRACT_TYPE">PUT</field>
                <value name="AMOUNT">
                  <block type="math_number">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </statement>

          </block>
        </statement>

      </block>
    </statement>

  </block>

</xml>
